# Dominio donde quedará la app (debe apuntar a la IP del servidor)
DOMAIN=admin.sygoabogados.com
# true si este servidor NO tiene otro proxy en los puertos 80/443 y Caddy debe encargarse del HTTPS.
# false si ya existe un proxy (por ejemplo el del CRM) que debe reenviar a 127.0.0.1:APP_PORT.
USE_CADDY=true
APP_PORT=3000

# Primer usuario administrador (solo se usa la primera vez que arranca la base de datos)
ADMIN_EMAIL=administracion@sygoabogados.com
ADMIN_PASSWORD=cambiar-esta-clave
ADMIN_NAME=Administradora

# Secretos: setup-server.sh los genera solos; si los pones a mano, usa valores largos y aleatorios
JWT_SECRET=
POSTGRES_PASSWORD=

# ---- WhatsApp y asistente (se llenan con deploy/configurar-whatsapp.sh) ----
# Evolution API: desde el contenedor de la app, el servidor se alcanza como host.docker.internal
EVOLUTION_URL=http://host.docker.internal:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=sygo-admin
WHATSAPP_WEBHOOK_SECRET=
# Clave de la API de Anthropic para el asistente
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Notas de voz: true levanta el contenedor transcriber (Whisper)
VOICE_NOTES=false
TRANSCRIBE_URL=
WHISPER_MODEL=small
